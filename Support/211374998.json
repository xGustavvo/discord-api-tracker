  "title": "What do those colored dots next to my avatar mean?",
  "url": "https://support.discord.com/hc/en-us/articles/211374998-What-do-those-colored-dots-next-to-my-avatar-mean",
  "locale": "en-us",
  "created_at": "2015-10-07T02:49:51Z",
